# Kopieren nach .env und ausfüllen. .env niemals teilen oder ins Repo laden.

# --- Lokal ---------------------------------------------------------------
# Ohne MONGODB_URI speichert der Server alles lokal in data/ (SQLite).
HOST=127.0.0.1
PORT=8130

# --- MongoDB Atlas (für Render, siehe DEPLOY.md) ---------------------------
# Mit gesetzter URI nutzt der Server MongoDB, Anhänge liegen dann in GridFS.
# Datenbankname steht in der URI hinter dem "/": ...mongodb.net/derpole?retryWrites=true&w=majority
MONGODB_URI=

# --- Nur auf Render setzen (macht render.yaml automatisch) --------------------
# NODE_ENV=production      -> sichere Cookies (nur HTTPS) und HSTS
# TRUST_PROXY=1            -> echte Besucher-IP hinter dem Render-Proxy (für Rate-Limits)
# HOST=0.0.0.0
# PUBLIC_ORIGIN=https://deine-seite.onrender.com
# ADMIN_USERNAME=Admin     -> legt beim Start das erste Admin-Konto an,
# ADMIN_PASSWORD_HASH=...     solange es noch keinen Admin gibt (Hash beginnt mit scrypt$)

# --- Optional -------------------------------------------------------------
# Maximale Größe pro Datei in MB (Atlas Free hat 512 MB Speicher insgesamt)
MAX_FILE_MB=25

# Discord-Bot (derzeit aus, siehe README)
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_ADMIN_IDS=
DISCORD_MAX_FILE_MB=10
